{
  "name": "neora-business-opportunity-index",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm data:sample && pnpm -r build",
    "data:sample": "tsx scripts/generate-sample.ts",
    "import:sample": "pnpm data:sample && uv run --project pipelines python -m pipelines.src.run_sample --handoff data/runtime/normalized-batch.json && tsx --env-file-if-exists=apps/web/.env.local scripts/import-sample.ts",
    "dev": "pnpm --filter @neora/web dev",
    "test": "pnpm -r test",
    "lint": "pnpm --filter @neora/web lint",
    "typecheck": "pnpm -r typecheck",
    "test:e2e": "pnpm --filter @neora/web test:e2e",
    "test:integration": "pnpm --filter @neora/db test:integration",
    "contracts:generate": "pnpm --filter @neora/contracts generate",
    "db:migrate": "pnpm --filter @neora/db db:migrate",
    "pipeline:test": "python -m pytest pipelines/tests"
  },
  "devDependencies": {
    "@neora/db": "workspace:*",
    "@neora/scoring": "workspace:*",
    "@types/node": "^22.18.6",
    "typescript": "^5.9.3",
    "tsx": "^4.20.6",
    "vitest": "^3.2.4"
  }
}
