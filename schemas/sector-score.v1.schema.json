{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "city": {
      "type": "string",
      "enum": [
        "Bogotá",
        "Medellín",
        "Cali"
      ]
    },
    "sector": {
      "type": "string"
    },
    "period": {
      "type": "string"
    },
    "score": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "confidenceLabel": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low",
        "insufficient"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "scored",
        "insufficient_data"
      ]
    },
    "modelVersion": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "observedAt": {
          "type": "string"
        },
        "licenseReviewStatus": {
          "type": "string",
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        }
      },
      "required": [
        "name",
        "url",
        "observedAt",
        "licenseReviewStatus"
      ],
      "additionalProperties": false
    },
    "factors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "contribution": {
            "type": [
              "number",
              "null"
            ]
          },
          "evidenceId": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "label",
          "value",
          "weight",
          "contribution",
          "evidenceId"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "city",
    "sector",
    "period",
    "score",
    "confidence",
    "confidenceLabel",
    "status",
    "modelVersion",
    "source",
    "factors"
  ],
  "additionalProperties": false
}
